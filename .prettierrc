{
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 4,
    "trailingComma": "es5",
    "printWidth": 80,
    "singleAttributePerLine": true,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "src/index.css",
    "tailwindFunctions": ["cn", "cva"]
}
